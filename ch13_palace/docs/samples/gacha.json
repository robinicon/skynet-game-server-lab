      "seed": { "gold": 2000, "heroes": {}, "activity": { "gacha": { "draws": 0, "pity": 0 } } },
      "op": "u.gachaDraw",
      "params": [],
      "expect": {
        "err": 200,
        "result": { "ok": true, "tpl": 2003, "rare": false, "forced": false, "draws": 1, "pity": 1, "cost": 100, "gold": 1900 },
        "state": { "gold": 1900, "activity.gacha.draws": 1, "activity.gacha.pity": 1 }
      }
    },
    {
      "name": "gacha_pity_forces_rare",
      "derivation": "draws=9/pity=9 达保底线(pity_limit-1=9)→本次强制稀有 2004；出稀有后 pity 归零；gold 2000-100=1900",
      "seed": { "gold": 2000, "heroes": {}, "activity": { "gacha": { "draws": 9, "pity": 9 } } },
      "op": "u.gachaDraw",
      "params": [],
      "expect": {
        "err": 200,
        "result": { "ok": true, "tpl": 2004, "rare": true, "forced": true, "draws": 10, "pity": 0, "gold": 1900 },
        "state": { "gold": 1900, "activity.gacha.draws": 10, "activity.gacha.pity": 0 }
      }
    },
    {
      "name": "gacha_duplicate_compensates_gold",
      "derivation": "已拥有 tpl=2003 英雄→重复，金币补偿+50；gold 2000-100+50=1950；heroes 不新增",
      "seed": { "gold": 2000, "heroes": { "h1": { "tpl": 2003, "lv": 1, "advance": 0, "limit": 0 } }, "activity": { "gacha": { "draws": 0, "pity": 0 } } },
      "op": "u.gachaDraw",
      "params": [],
      "expect": {
        "err": 200,
        "result": { "ok": true, "tpl": 2003, "duplicate": true, "gold": 1950 },
        "state": { "gold": 1950 }
      }
    },
    {
      "name": "gacha_gold_not_enough",
      "derivation": "gold=50 < cost=100 → gold_not_enough，无状态变更",
      "seed": { "gold": 50, "heroes": {}, "activity": {} },
      "op": "u.gachaDraw",
      "params": [],
      "expect": {
        "err": -200,
        "result": { "ok": false, "reason": "gold_not_enough" },
        "state": { "gold": 50 }
      }
