{
  "batch": "home",
  "source": "authored demo content (U6_M3_DEVLOG §2.3)",
  "notes": "家园主城建筑等级 1~5；升级扣 home[next].upgradeGold 并结算旧等级产出（harvested 计数防重）；数值来自 gamedata home 表。",
  "cases": [
    {
      "name": "home_info_initial",
      "derivation": "无 activity.home → level=1，升到 lv2 花 home[2].upgradeGold=200，产出 home[1].produceItem=1001 x1",
      "seed": { "gold": 1000, "bag": {}, "activity": {} },
      "op": "u.homeInfo",
      "params": [],
      "expect": {
        "err": 200,
        "result": { "ok": true, "level": 1, "upgradeGold": 200, "produceItem": 1001, "produceNum": 1, "maxLevel": 5 },
        "state": { "gold": 1000 }
      }
    },
    {
      "name": "home_upgrade_to_level2",
      "derivation": "level=1→2，扣 200(home[2].upgradeGold)，结算旧 lv1 产出 1001x1；gold 1000-200=800，bag.1001=1",
      "seed": { "gold": 1000, "bag": {}, "activity": { "home": { "level": 1, "harvested": 0 } } },
      "op": "u.homeUpgrade",
      "params": [],
      "expect": {
        "err": 200,
        "result": { "ok": true, "level": 2, "cost": 200, "gold": 800, "produced": 1, "producedItem": 1001 },
        "state": { "gold": 800, "bag.1001": 1, "activity.home.level": 2, "activity.home.harvested": 1 }
      }
    },
    {
      "name": "home_upgrade_no_reharvest",
      "derivation": "level=2/harvested=1 已领过旧产出→升 lv3 不再重复发产出；gold 1000-300=700，bag 不变",
      "seed": { "gold": 1000, "bag": {}, "activity": { "home": { "level": 2, "harvested": 1 } } },
      "op": "u.homeUpgrade",
      "params": [],
      "expect": {
        "err": 200,
        "result": { "ok": true, "level": 3, "cost": 300, "produced": 0 },
        "state": { "gold": 700, "activity.home.level": 3 }
      }
    },
    {
      "name": "home_max_level",
      "derivation": "level=5 已达上限 → max_level，无状态变更",
      "seed": { "gold": 1000, "bag": {}, "activity": { "home": { "level": 5, "harvested": 5 } } },
      "op": "u.homeUpgrade",
      "params": [],
      "expect": {
        "err": -200,
        "result": { "ok": false, "reason": "max_level" },
        "state": { "gold": 1000, "activity.home.level": 5 }
      }
    },
    {
      "name": "home_upgrade_gold_not_enough",
      "derivation": "level=1 升 lv2 需 200，gold=100 不足 → gold_not_enough",
      "seed": { "gold": 100, "bag": {}, "activity": { "home": { "level": 1, "harvested": 0 } } },
      "op": "u.homeUpgrade",
      "params": [],
      "expect": {
        "err": -200,
        "result": { "ok": false, "reason": "gold_not_enough" },
        "state": { "gold": 100, "activity.home.level": 1 }
      }
    }
  ]
}
