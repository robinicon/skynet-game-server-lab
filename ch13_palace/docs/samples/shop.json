{
  "batch": "shop",
  "source": "U4 商店；货品/价格/限购来自 conf/gamedata.xlsx shop 表。",
  "notes": "currency gold/silver 直接改字段；道具进背包；已购数记 activity.shop.bought。",
  "cases": [
    {
      "name": "shop_buy_gold_item",
      "derivation": "goods101=小还丹(1001) gold价100，买2 → 扣200 gold，背包+2，bought[101]=2",
      "seed": { "gold": 1000, "silver": 500, "bag": {}, "activity": { "shop": { "bought": {} } } },
      "op": "u.shopBuy",
      "params": [101, 2],
      "expect": {
        "err": 200,
        "result": { "ok": true, "goodsId": 101, "count": 2, "currency": "gold", "spent": 200, "itemId": 1001 },
        "state": { "gold": 800, "bag.1001": 2, "activity.shop.bought.101": 2 }
      }
    },
    {
      "name": "shop_buy_silver_item",
      "derivation": "goods103=官印(3001) silver价200，买1 → 扣200 silver，背包+1",
      "seed": { "gold": 1000, "silver": 500, "bag": {}, "activity": { "shop": { "bought": {} } } },
      "op": "u.shopBuy",
      "params": [103, 1],
      "expect": {
        "err": 200,
        "result": { "ok": true, "currency": "silver", "spent": 200 },
        "state": { "silver": 300, "bag.3001": 1 }
      }
    },
    {
      "name": "shop_limit_exceeded",
      "derivation": "goods102 限购5，bought=5 再买1 → limit_exceeded，无扣款",
      "seed": { "gold": 1000, "bag": {}, "activity": { "shop": { "bought": { "102": 5 } } } },
      "op": "u.shopBuy",
      "params": [102, 1],
      "expect": {
        "err": -200,
        "result": { "ok": false, "reason": "limit_exceeded" },
        "state": { "gold": 1000, "activity.shop.bought.102": 5 }
      }
    },
    {
      "name": "shop_gold_not_enough",
      "derivation": "goods101 gold价100 买20 需2000 > seed gold100 → gold_not_enough",
      "seed": { "gold": 100, "activity": { "shop": { "bought": {} } } },
      "op": "u.shopBuy",
      "params": [101, 20],
      "expect": {
        "err": -200,
        "result": { "ok": false, "reason": "gold_not_enough", "need": 2000, "have": 100 },
        "state": { "gold": 100 }
      }
    },
    {
      "name": "shop_goods_not_found",
      "derivation": "goods999 不存在 → goods_not_found",
      "seed": { "gold": 1000, "activity": { "shop": { "bought": {} } } },
      "op": "u.shopBuy",
      "params": [999, 1],
      "expect": { "err": -200, "result": { "ok": false, "reason": "goods_not_found" } }
    }
  ]
}
