      "seed": { "bag": { "9001": 2 } },
      "op": "u.useItem",
      "params": [9001, 2, 0],
      "expect": {
        "err": 200,
        "result": { "ok": true, "gain": 2000, "field": "gold" },
        "state": { "gold": 2000, "bag.9001": null }
      }
    },
    {
      "name": "use_elixir_rejected",
      "derivation": "经验丹只由英雄升级吞掉；直接使用返回 not_usable，且不扣道具",
      "seed": { "bag": { "1001": 1 } },
      "op": "u.useItem",
      "params": [1001, 1, 0],
      "expect": {
        "err": -200,
        "result": { "ok": false, "reason": "not_usable" },
        "state": { "bag.1001": 1 }
      }
    },
    {
      "name": "use_material_rejected",
      "derivation": "官印无使用效果",
      "seed": { "bag": { "3002": 1 } },
      "op": "u.useItem",
      "params": [3002, 1, 0],
      "expect": {
        "err": -200,
        "result": { "ok": false, "reason": "not_usable" },
        "state": { "bag.3002": 1 }
      }
    },
    {
      "name": "sale_ok",
      "derivation": "小还丹 sellPrice=10，卖 3 个 → 银币 +30，背包清空",
      "seed": { "bag": { "1001": 3 } },
      "op": "u.itemSale",
      "params": [1001, 3],
      "expect": {
        "err": 200,
        "result": { "ok": true, "gain": 30 },
        "state": { "silver": 30, "bag.1001": null }
      }
    },
    {
      "name": "sale_price_zero",
      "derivation": "官印 sellPrice=0，原 sellType=0 → 不可出售，背包不变",
      "seed": { "bag": { "3001": 1 } },
      "op": "u.itemSale",
      "params": [3001, 1],
      "expect": {
        "err": -200,
        "result": { "ok": false, "reason": "not_sellable" },
        "state": { "bag.3001": 1, "silver": null }
      }
    },
    {
      "name": "sale_insufficient",
      "derivation": "只有 1 个却卖 2 个 → item_not_enough，库存不变",
      "seed": { "bag": { "1001": 1 } },
      "op": "u.itemSale",
      "params": [1001, 2],
      "expect": {
        "err": -200,
        "result": { "ok": false, "reason": "item_not_enough" },
