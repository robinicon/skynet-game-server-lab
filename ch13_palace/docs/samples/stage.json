{
  "batch": "stage",
  "source": "U4 关卡批次；数值来自 conf/gamedata.xlsx stage 表（authored demo content）。",
  "notes": "每条 derivation 记录期望从哪条规则推出。10 连打的累计值由 U4_DEVLOG §3.2 公式导出。",
  "cases": [
    {
      "name": "stage1_first_clear",
      "derivation": "关1 needLevel=1/exp=100/gold=50/drop=1001x1；seed level=1 满足门槛，逐关 clearMax 0→1",
      "seed": { "level": 1, "gold": 0, "bag": {}, "activity": { "stage": { "clearMax": 0, "exp": 0 } } },
      "op": "u.stageChallenge",
      "params": [1],
      "expect": {
        "err": 200,
        "result": { "ok": true, "win": true, "stageId": 1, "clearMax": 1, "exp": 100, "gold": 50, "dropItem": 1001, "dropNum": 1 },
        "state": { "activity.stage.clearMax": 1, "activity.stage.exp": 100, "gold": 50, "bag.1001": 1 }
      }
    },
    {
      "name": "stage_skip_locked",
      "derivation": "clearMax=0 时直接挑战 stage3 违反逐关推进 → stage_locked，无状态变更",
      "seed": { "level": 10, "gold": 0, "activity": { "stage": { "clearMax": 0, "exp": 0 } } },
      "op": "u.stageChallenge",
      "params": [3],
      "expect": {
        "err": -200,
        "result": { "ok": false, "reason": "stage_locked" },
        "state": { "activity.stage.clearMax": 0, "gold": 0 }
      }
    },
    {
      "name": "stage_level_too_low",
      "derivation": "stage2 needLevel=2，seed level=1 未达门槛 → level_too_low",
      "seed": { "level": 1, "gold": 0, "activity": { "stage": { "clearMax": 1, "exp": 100 } } },
      "op": "u.stageChallenge",
      "params": [2],
      "expect": {
        "err": -200,
        "result": { "ok": false, "reason": "level_too_low", "needLevel": 2 },
        "state": { "activity.stage.clearMax": 1 }
      }
    },
    {
      "name": "stage_sweep_cleared",
      "derivation": "扫荡已通关 stage1 ×3：exp=100*3=300，gold=50*3=150，drop=1001*3",
      "seed": { "level": 10, "gold": 0, "bag": {}, "activity": { "stage": { "clearMax": 3, "exp": 300 } } },
      "op": "u.stageSweep",
      "params": [1, 3],
      "expect": {
        "err": 200,
        "result": { "ok": true, "stageId": 1, "times": 3, "exp": 300, "gold": 150, "dropNum": 3 },
        "state": { "activity.stage.exp": 600, "gold": 150, "bag.1001": 3 }
      }
    },
    {
      "name": "stage_sweep_uncleared",
      "derivation": "clearMax=1 扫荡 stage5 属未通关 → stage_not_cleared",
      "seed": { "level": 10, "gold": 0, "activity": { "stage": { "clearMax": 1, "exp": 100 } } },
      "op": "u.stageSweep",
      "params": [5, 1],
      "expect": {
        "err": -200,
        "result": { "ok": false, "reason": "stage_not_cleared" },
        "state": { "gold": 0 }
      }
    },
    {
      "name": "stage10_final_clear",
      "derivation": "clearMax=9 挑战最终关10：needLevel=10/exp=280/gold=140/drop=1002x4，推进到10",
      "seed": { "level": 10, "gold": 0, "bag": {}, "activity": { "stage": { "clearMax": 9, "exp": 1620 } } },
      "op": "u.stageChallenge",
      "params": [10],
      "expect": {
        "err": 200,
        "result": { "ok": true, "clearMax": 10, "exp": 280, "gold": 140, "dropItem": 1002, "dropNum": 4 },
        "state": { "activity.stage.clearMax": 10, "activity.stage.exp": 1900, "gold": 140, "bag.1002": 4 }
      }
    }
  ]
}
