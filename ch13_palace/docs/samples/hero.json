  "cases": [
    {
      "name": "lv_up_single_step",
      "derivation": "lv1->2 需 100 经验，小还丹 100/颗 → 消耗 1 颗，经验不溢出",
      "seed": {
        "level": 30,
        "heroes": { "h1": { "tpl": 2001, "lv": 1, "exp": 0, "advance": 0, "limit": 0 } },
        "bag": { "1001": 10 }
      },
      "op": "u.heroUpdateLvAuto",
      "params": ["h1", false],
      "expect": {
        "err": 200,
        "result": { "ok": true, "lv": 2, "exp": 0, "toLv": 2, "gainedExp": 100, "cost": { "1001": 1 } },
        "state": { "heroes.h1.lv": 2, "heroes.h1.exp": 0, "bag.1001": 9 }
      }
    },
    {
      "name": "lv_up_auto_capped_by_advance",
      "derivation": "adv0 的 lvLimit=10；lv2->10 需 150+200+250+300+350+400+450+500=2600；大还丹 2000/颗，2 颗得 4000，溢出 1400 留身上",
      "seed": {
        "level": 30,
        "heroes": { "h1": { "tpl": 2001, "lv": 2, "exp": 0, "advance": 0, "limit": 0 } },
        "bag": { "1003": 2 }
      },
      "op": "u.heroUpdateLvAuto",
      "params": ["h1", true],
      "expect": {
        "err": 200,
        "result": { "lv": 10, "exp": 1400, "toLv": 10, "gainedExp": 4000, "cost": { "1003": 2 } },
        "state": { "heroes.h1.lv": 10, "heroes.h1.exp": 1400, "bag.1003": null }
      }
    },
    {
      "name": "lv_up_capped_by_avatar_level",
